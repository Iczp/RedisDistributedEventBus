  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\RedisDistributedEventBus\*.json" />
    <Content Remove="Localization\RedisDistributedEventBus\*.json" />
  </ItemGroup>

</Project>
